{
  "name": "market-bell",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "triggers": { "crons": ["30 10 * * MON-FRI", "30 2 * * MON-FRI"] },
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "701485",
    "simple": { "limit": 8, "period": 60 }
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stock-alerts",
    "database_id": "635ecc10-da22-48f5-86f2-8b8f0b2bbbd7"
  }]
}
